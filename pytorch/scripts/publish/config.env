# Maven Central publish config for io.github.mullerhai JavaCPP stack
# Source this file:  source scripts/publish/config.env

export PUBLISH_GROUP_ID="io.github.mullerhai"
export PUBLISH_ORG_NAME="mullerhai"
export PUBLISH_DEVELOPER_ID="mullerhai"
export PUBLISH_DEVELOPER_NAME="muller"
export PUBLISH_DEVELOPER_EMAIL="hai710459649@foxmail.com"
export PUBLISH_DEVELOPER_URL="https://github.com/mullerhai"
export PUBLISH_SCM_URL="https://github.com/mullerhai/javacpp-presets"
export PUBLISH_SCM_CONNECTION="scm:git:git://github.com/mullerhai/javacpp-presets.git"
export PUBLISH_SCM_DEV_CONNECTION="scm:git:ssh://git@github.com/mullerhai/javacpp-presets.git"
export PUBLISH_PROJECT_URL="https://github.com/mullerhai/javacpp-presets"
export PUBLISH_LICENSE_NAME="Apache License, Version 2.0"
export PUBLISH_LICENSE_URL="https://www.apache.org/licenses/LICENSE-2.0"

# Version suffix: SNAPSHOT -> beta-07 (full stack + tensorrt/tritonserver + cuda-redist)
export PUBLISH_SUFFIX="beta-08"
export JAVACPP_BASE="1.5.14"
export OPENBLAS_LIB="0.3.33"
export CUDA_LIB="13.3-9.24"
export PYTORCH_LIB="2.13.0"
export FFMPEG_LIB="8.1.1"
export OPENCV_LIB="4.13.0"
export CPYTHON_LIB="3.14.6"
export NUMPY_LIB="2.5.0"
export TENSORRT_LIB="11.1"
export TRITONSERVER_LIB="2.70.0"

export JAVACPP_VERSION="${JAVACPP_BASE}-${PUBLISH_SUFFIX}"
export OPENBLAS_VERSION="${OPENBLAS_LIB}-${JAVACPP_BASE}-${PUBLISH_SUFFIX}"
export CUDA_VERSION="${CUDA_LIB}-${JAVACPP_BASE}-${PUBLISH_SUFFIX}"
export PYTORCH_VERSION="${PYTORCH_LIB}-${JAVACPP_BASE}-${PUBLISH_SUFFIX}"
export FFMPEG_VERSION="${FFMPEG_LIB}-${JAVACPP_BASE}-${PUBLISH_SUFFIX}"
export OPENCV_VERSION="${OPENCV_LIB}-${JAVACPP_BASE}-${PUBLISH_SUFFIX}"
export CPYTHON_VERSION="${CPYTHON_LIB}-${JAVACPP_BASE}-${PUBLISH_SUFFIX}"
export NUMPY_VERSION="${NUMPY_LIB}-${JAVACPP_BASE}-${PUBLISH_SUFFIX}"
export TENSORRT_VERSION="${TENSORRT_LIB}-${JAVACPP_BASE}-${PUBLISH_SUFFIX}"
export TRITONSERVER_VERSION="${TRITONSERVER_LIB}-${JAVACPP_BASE}-${PUBLISH_SUFFIX}"

# GPG
export GPG_KEY_ID="${GPG_KEY_ID:-7AD293084072FD9F}"
export GPG_FINGERPRINT="${GPG_FINGERPRINT:-ED8664EC6A980A6C6CF721787AD293084072FD9F}"

# Paths
export PUBLISH_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
export STAGE_DIR="${STAGE_DIR:-$PUBLISH_ROOT/staging}"
export BUNDLE_DIR="${BUNDLE_DIR:-$PUBLISH_ROOT/bundles}"
export M2_BYTEDECO="${M2_BYTEDECO:-$HOME/.m2/repository/org/bytedeco}"

# Sonatype Central Portal credentials (REQUIRED for upload)
# Create at: https://central.sonatype.com/account
# Prefer user token: username = token name, password = token value
# export CENTRAL_USERNAME="..."
# export CENTRAL_PASSWORD="..."
# Or put them in ~/.m2/settings.xml under <server><id>central</id>
