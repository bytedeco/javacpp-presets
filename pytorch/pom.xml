<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.bytedeco</groupId>
    <artifactId>javacpp-presets</artifactId>
    <version>1.5.14-SNAPSHOT</version>
  </parent>

  <groupId>org.bytedeco</groupId>
  <artifactId>pytorch</artifactId>
  <version>2.13.0-${project.parent.version}</version>
  <name>JavaCPP Presets for PyTorch</name>

  <properties>
    <!-- Set -Dpytorch.relocate.skip=true to skip post-parse package relocation -->
    <pytorch.relocate.skip>false</pytorch.relocate.skip>
    <!-- Unpack macosx-arm64 dylibs into target/classes for IDE Application runs.
         Set -Dpytorch.ide.natives.skip=true to skip (e.g. CI package-only builds). -->
    <pytorch.ide.natives.skip>false</pytorch.ide.natives.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.bytedeco</groupId>
      <artifactId>javacpp</artifactId>
    </dependency>
    <!-- Local IDE / sample runs need the platform native jars on the classpath.
         Do NOT depend on *-platform (pulls every OS). Mirror ffmpeg/opencv below:
         Java API jar + optional current-host classifier only.
         javacpp version must be ${project.parent.version} (== 1.5.14-SNAPSHOT),
         NOT 1.5.14-${project.parent.version} (expands to invalid 1.5.14-1.5.14-SNAPSHOT). -->
    <dependency>
      <groupId>org.bytedeco</groupId>
      <artifactId>javacpp</artifactId>
      <version>${project.parent.version}</version>
      <classifier>macosx-arm64</classifier>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.bytedeco</groupId>
      <artifactId>openblas</artifactId>
      <version>0.3.33-${project.parent.version}</version>
    </dependency>
    <dependency>
      <groupId>org.bytedeco</groupId>
      <artifactId>openblas</artifactId>
      <version>0.3.33-${project.parent.version}</version>
      <classifier>macosx-arm64</classifier>
      <optional>true</optional>
    </dependency>
    <!-- "junit" % "junit" % "4.13.2" ,// % Test -->
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
<!--      <scope>test</scope>-->
    </dependency>
    <!-- Own platform jar from local m2 (after mvn install). Needed for IDE runs when
         target/ was cleaned: Make only recompiles .class, not libjnitorch.dylib.
         optional + runtime so it is not a published transitive; consumers use pytorch-platform. -->
<!--    <dependency>-->
<!--      <groupId>org.bytedeco</groupId>-->
<!--      <artifactId>pytorch</artifactId>-->
<!--      <version>${project.version}</version>-->
<!--      <classifier>macosx-arm64</classifier>-->
<!--      <optional>true</optional>-->
<!--      <scope>runtime</scope>-->
<!--    </dependency>-->

    <dependency>
      <groupId>org.bytedeco</groupId>
      <artifactId>cuda</artifactId>
      <version>13.3-9.24-${project.parent.version}</version>
      <optional>true</optional>
    </dependency>
    <!-- Parquet I/O: pure Java (column/common/encoding/format only).
         NO parquet-hadoop, NO Hadoop/Hive. File format handled by our
         ParquetInputFormat / ParquetOutputFormat in data.parquet. -->
    <dependency>
      <groupId>org.apache.parquet</groupId>
      <artifactId>parquet-column</artifactId>
      <version>1.17.1</version>
      <exclusions>
        <exclusion>
          <groupId>org.apache.hadoop</groupId>
          <artifactId>*</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.apache.parquet</groupId>
          <artifactId>parquet-hadoop</artifactId>
        </exclusion>
        <!-- jts-core CANNOT be excluded: PrimitiveStringifier.<clinit> creates WKB_STRINGIFIER
             whose exception table references org.locationtech.jts.io.ParseException. -->
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.apache.parquet</groupId>
      <artifactId>parquet-common</artifactId>
      <version>1.17.1</version>
      <exclusions>
        <exclusion>
          <groupId>org.apache.hadoop</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.apache.parquet</groupId>
      <artifactId>parquet-encoding</artifactId>
      <version>1.17.1</version>
    </dependency>
    <!-- Thrift FileMetaData / PageHeader (shaded thrift inside). -->
    <!-- javax.annotation-api is compile-only thrift noise; no runtime class refs in the jar. -->
    <dependency>
      <groupId>org.apache.parquet</groupId>
      <artifactId>parquet-format-structures</artifactId>
      <version>1.17.1</version>
      <exclusions>
        <exclusion>
          <groupId>javax.annotation</groupId>
          <artifactId>javax.annotation-api</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- parquet-jackson: shaded Jackson for parquet-hadoop JSON metadata only.
         We exclude parquet-hadoop and never touch shaded parquet jackson — drop it. -->
    <!-- Codecs used by parquet (ZSTD/snappy) via ZstdCodecFactory -->
    <dependency>
      <groupId>org.xerial.snappy</groupId>
      <artifactId>snappy-java</artifactId>
      <version>1.1.10.7</version>
    </dependency>
    <dependency>
      <groupId>com.github.luben</groupId>
      <artifactId>zstd-jni</artifactId>
      <version>1.5.7-3</version>
    </dependency>
    <!-- Arrow IPC / Feather v2 I/O (pure Java); 18.3.0 aligned with org.lance:lance-core -->
    <!--
      arrow-vector needs Jackson core/databind/annotations/jsr310: Schema's <clinit>
      creates ObjectMapper — excluding those 4 packages breaks Arrow/Lance.
      Only the 4 jaxrs/openapi Jackson packages (from lance-namespace) are safe to drop.
    -->
    <dependency>
      <groupId>org.apache.arrow</groupId>
      <artifactId>arrow-vector</artifactId>
      <version>18.3.0</version>
      <exclusions>
        <!-- Only JsonFileReader/Writer hex helpers; we use binary IPC, not Arrow JSON -->
        <exclusion>
          <groupId>commons-codec</groupId>
          <artifactId>commons-codec</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- Unsafe allocator: no io.netty (was arrow-memory-netty → netty-buffer/common) -->
    <dependency>
      <groupId>org.apache.arrow</groupId>
      <artifactId>arrow-memory-unsafe</artifactId>
      <version>18.3.0</version>
    </dependency>
    <dependency>
      <groupId>org.apache.arrow</groupId>
      <artifactId>arrow-c-data</artifactId>
      <version>18.3.0</version>
    </dependency>
    <dependency>
      <groupId>org.apache.arrow</groupId>
      <artifactId>arrow-dataset</artifactId>
      <version>18.3.0</version>
    </dependency>
    <!-- Excel (.xlsx/.xls): pure OOXML + minimal BIFF8 in dataframe.excel.internal (no POI) -->
    <!-- Embedded SQLite for DataFrame SQL I/O; other DBs via caller-provided JDBC -->
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>3.49.1.0</version>
    </dependency>
    <!-- HDF5: pure-Java minimal columnar/matrix codec in dataframe.hdf5.internal (no jhdf) -->
    <!-- Avro data files (parquet-avro may already transitively pull this) -->
    <!-- Avro: we only use null/deflate/snappy codecs (JDK zip + snappy-java).
         commons-compress is only for bzip2/xz/zstd avro codecs — unused. -->
    <dependency>
      <groupId>org.apache.avro</groupId>
      <artifactId>avro</artifactId>
      <version>1.12.0</version>
      <exclusions>
        <exclusion>
          <groupId>org.apache.commons</groupId>
          <artifactId>commons-compress</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- ORC dual backend:
         - legacy: DuckDB read_orc / COPY ORC (LocalOrcReader/Writer, DataFrame.readOrc/toOrc)
         - pure-Java: orc-format protobuf only (LocalOrcFormat*, DataFrame.readOrcFormat/toOrcFormat)
         Intentionally NO orc-core / hive-storage-api / Hadoop. -->
    <!-- Official DuckDB JDBC (embedded OLAP; reads parquet/csv/json/orc natively) -->
    <dependency>
      <groupId>org.duckdb</groupId>
      <artifactId>duckdb_jdbc</artifactId>
      <version>1.5.5.0</version>
    </dependency>
    <!-- Official Lance format Java API (multimodal vector lakehouse; Arrow IPC interop) -->
    <!-- Drop Lance Namespace REST client (unused): removes httpclient5 + 4 Jackson jaxrs/openapi pkgs.
         Drop arrow-memory-netty (we use arrow-memory-unsafe above instead of netty).
         Drop guava: lance-core already shades it as org.lance.shaded.guava (createDependencyReducedPom=false
         still exposes the unshaded coordinates transitively; no external com.google.common refs remain).
         Drop commons-lang3: zero refs in lance-core classes (dead transitive).
         Keep org.questdb:jar-jni — JniLoader.<clinit> calls JarJniLoader.loadLib (required for Dataset). -->
    <dependency>
      <groupId>org.lance</groupId>
      <artifactId>lance-core</artifactId>
      <version>10.0.0-beta.5</version>
      <exclusions>
        <exclusion>
          <groupId>org.lance</groupId>
          <artifactId>lance-namespace-apache-client</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.lance</groupId>
          <artifactId>lance-namespace-core</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.apache.arrow</groupId>
          <artifactId>arrow-memory-netty</artifactId>
        </exclusion>
        <exclusion>
          <groupId>com.google.guava</groupId>
          <artifactId>guava</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.apache.commons</groupId>
          <artifactId>commons-lang3</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- ORC protobuf definitions only (OrcProto); pure-Java codec in data.orc.*Format* -->
    <!-- Source: https://mvnrepository.com/artifact/org.apache.orc/orc-format -->
    <dependency>
      <groupId>org.apache.orc</groupId>
      <artifactId>orc-format</artifactId>
      <version>1.1.1</version>
      <scope>compile</scope>
    </dependency>
    <!-- orc-format ships OrcProto against unshaded com.google.protobuf (main jar is not
         the shaded-protobuf classifier). Required for GeneratedMessageV3 / toByteArray(). -->
    <dependency>
      <groupId>com.google.protobuf</groupId>
      <artifactId>protobuf-java</artifactId>
      <version>3.25.5</version>
    </dependency>
    <!-- StructureSpec JSON (model structure dump / round-trip). -->
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>2.12.1</version>
    </dependency>
    <!-- Apache Kafka clients: streaming feature logs / online training / DataFrame source-sink -->
    <!-- Source: https://mvnrepository.com/artifact/org.apache.kafka/kafka-clients -->
    <dependency>
      <groupId>org.apache.kafka</groupId>
      <artifactId>kafka-clients</artifactId>
      <version>4.3.1</version>
      <scope>compile</scope>
    </dependency>
    <!-- FFmpeg JavaCPP: video / audio decode-encode via libav -->
    <dependency>
      <groupId>org.bytedeco</groupId>
      <artifactId>ffmpeg</artifactId>
      <version>8.1.1-${project.parent.version}</version>
    </dependency>
    <dependency>
      <groupId>org.bytedeco</groupId>
      <artifactId>ffmpeg</artifactId>
      <version>8.1.1-${project.parent.version}</version>
      <classifier>macosx-arm64</classifier>
      <optional>true</optional>
    </dependency>
    <!-- OpenCV JavaCPP: image I/O, transforms, computer vision -->
    <dependency>
      <groupId>org.bytedeco</groupId>
      <artifactId>opencv</artifactId>
      <version>4.13.0-${project.parent.version}</version>
    </dependency>
    <dependency>
      <groupId>org.bytedeco</groupId>
      <artifactId>opencv</artifactId>
      <version>4.13.0-${project.parent.version}</version>
      <classifier>macosx-arm64</classifier>
      <optional>true</optional>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-resources-plugin</artifactId>
      </plugin>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <!-- DataFrame / feature / ML stack uses records, sealed types, pattern matching, switch expressions. -->
          <source>17</source>
          <target>17</target>
          <release>17</release>
          <!-- Demo / ad-hoc *Test* and *Benchmark* under main use JUnit or are not part of the library surface. -->
          <excludes>
            <exclude>**/geometric/demo/**/*Test.java</exclude>
            <exclude>**/geometric/demo/**/*Benchmark*.java</exclude>
            <exclude>**/rl/**/*Test.java</exclude>
            <exclude>**/utils/**/demo/**/*.java</exclude>
          </excludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.bytedeco</groupId>
        <artifactId>javacpp</artifactId>
        <dependencies>
          <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>openblas-platform</artifactId>
            <version>0.3.33-${project.parent.version}</version>
          </dependency>
          <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>cuda-platform</artifactId>
            <version>13.3-9.24-${project.parent.version}</version>
          </dependency>
          <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>numpy-platform</artifactId>
            <version>2.5.0-${project.parent.version}</version>
          </dependency>
          <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>cpython</artifactId>
            <version>3.14.5-${project.parent.version}</version>
            <classifier>${os.name}-${os.arch}</classifier>
          </dependency>
          <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>ffmpeg-platform</artifactId>
            <version>8.1.1-${project.parent.version}</version>
          </dependency>
          <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>opencv-platform</artifactId>
            <version>4.13.0-${project.parent.version}</version>
          </dependency>
        </dependencies>
        <configuration>
          <classPaths>
            <classPath>${basedir}/../openblas/target/classes/</classPath>
            <classPath>${basedir}/../cpython/target/classes/</classPath>
            <classPath>${basedir}/../numpy/target/classes/</classPath>
            <classPath>${basedir}/../cuda/target/classes/</classPath>
            <classPath>${project.build.outputDirectory}</classPath>
          </classPaths>
          <includePaths>
            <includePath>${basedir}/../openblas/src/main/resources/org/bytedeco/openblas/include/</includePath>
            <includePath>${basedir}/../openblas/target/classes/org/bytedeco/openblas/include/</includePath>
            <includePath>${basedir}/../openblas/cppbuild/${javacpp.platform}/include/</includePath>
            <includePath>${basedir}/../cpython/src/main/resources/org/bytedeco/cpython/include/</includePath>
            <includePath>${basedir}/../cpython/target/classes/org/bytedeco/cpython/include/</includePath>
            <includePath>${basedir}/../cpython/cppbuild/${javacpp.platform}/include/</includePath>
            <includePath>${basedir}/../numpy/src/main/resources/org/bytedeco/numpy/include/</includePath>
            <includePath>${basedir}/../numpy/target/classes/org/bytedeco/numpy/include/</includePath>
            <includePath>${basedir}/../numpy/cppbuild/${javacpp.platform}/include/</includePath>
            <includePath>${basedir}/../ffmpeg/cppbuild/${javacpp.platform}/include/</includePath>
            <includePath>${basedir}/../opencv/cppbuild/${javacpp.platform}/include/</includePath>
            <includePath>${basedir}/cppbuild/${javacpp.platform}${javacpp.platform.extension}/include/torch/csrc/api/include/</includePath>
            <includePath>${basedir}/cppbuild/${javacpp.platform}${javacpp.platform.extension}/include/</includePath>
            <includePath>${basedir}/target/classes/org/bytedeco/${javacpp.packageName}/include/</includePath>
            <!-- OpenMPI / MPICH for jnitorch_mpi (ProcessGroupMPI). -->
            <includePath>/opt/homebrew/opt/open-mpi/include/</includePath>
            <includePath>/usr/local/opt/open-mpi/include/</includePath>
            <includePath>/usr/include/openmpi/</includePath>
            <includePath>/usr/lib/x86_64-linux-gnu/openmpi/include/</includePath>
          </includePaths>
          <linkPaths>
            <linkPath>${basedir}/../openblas/cppbuild/${javacpp.platform}/lib/</linkPath>
            <linkPath>${basedir}/../cpython/cppbuild/${javacpp.platform}/lib/</linkPath>
            <linkPath>${basedir}/../numpy/cppbuild/${javacpp.platform}/lib/</linkPath>
            <linkPath>${basedir}/../ffmpeg/cppbuild/${javacpp.platform}/lib/</linkPath>
            <linkPath>${basedir}/../opencv/cppbuild/${javacpp.platform}/lib/</linkPath>
            <linkPath>${basedir}/cppbuild/${javacpp.platform}${javacpp.platform.extension}/lib/</linkPath>
            <linkPath>/opt/homebrew/opt/open-mpi/lib/</linkPath>
            <linkPath>/usr/local/opt/open-mpi/lib/</linkPath>
            <linkPath>/usr/lib/x86_64-linux-gnu/openmpi/lib/</linkPath>
          </linkPaths>
          <preloadPaths>
            <preloadPath>${basedir}/../openblas/cppbuild/${javacpp.platform}/bin/</preloadPath>
            <preloadPath>${basedir}/../cpython/cppbuild/${javacpp.platform}/bin/</preloadPath>
            <preloadPath>${basedir}/../numpy/cppbuild/${javacpp.platform}/bin/</preloadPath>
            <preloadPath>${basedir}/../ffmpeg/cppbuild/${javacpp.platform}/bin/</preloadPath>
            <preloadPath>${basedir}/../opencv/cppbuild/${javacpp.platform}/bin/</preloadPath>
          </preloadPaths>
          <buildResources>
            <buildResource>/${javacpp.platform.library.path}/</buildResource>
            <buildResource>/org/bytedeco/openblas/${javacpp.platform}/</buildResource>
            <buildResource>/org/bytedeco/cpython/${javacpp.platform}/</buildResource>
            <!-- add host cpython for running setup.py when cross-compiling -->
            <buildResource>/org/bytedeco/cpython/${os.name}-${os.arch}/</buildResource>
            <buildResource>/org/bytedeco/mkldnn/${javacpp.platform}/</buildResource>
            <buildResource>/org/bytedeco/numpy/${javacpp.platform}/</buildResource>
          </buildResources>
          <includeResources>
            <includeResource>/${javacpp.platform.library.path}/include/</includeResource>
            <includeResource>/org/bytedeco/openblas/include/</includeResource>
            <includeResource>/org/bytedeco/openblas/${javacpp.platform}/include/</includeResource>
            <includeResource>/org/bytedeco/cpython/include/</includeResource>
            <includeResource>/org/bytedeco/cpython/${javacpp.platform}/include/</includeResource>
            <includeResource>/org/bytedeco/numpy/include/</includeResource>
            <includeResource>/org/bytedeco/numpy/${javacpp.platform}/include/</includeResource>
          </includeResources>
          <linkResources>
            <linkResource>/${javacpp.platform.library.path}/</linkResource>
            <linkResource>/${javacpp.platform.library.path}/lib/</linkResource>
            <linkResource>/org/bytedeco/openblas/${javacpp.platform}/</linkResource>
            <linkResource>/org/bytedeco/openblas/${javacpp.platform}/lib/</linkResource>
            <linkResource>/org/bytedeco/cpython/${javacpp.platform}/</linkResource>
            <linkResource>/org/bytedeco/cpython/${javacpp.platform}/lib/</linkResource>
            <linkResource>/org/bytedeco/cpython/${javacpp.platform}/libs/</linkResource>
            <linkResource>/org/bytedeco/numpy/${javacpp.platform}/</linkResource>
            <linkResource>/org/bytedeco/numpy/${javacpp.platform}/lib/</linkResource>
          </linkResources>
        </configuration>
        <executions>
          <!-- Parent binds javacpp-compiler at process-classes and scans
               org.bytedeco.pytorch.**. Pure-Java helpers (parquet/orc/dataframe/…)
               are loaded during that scan, so compile deps must be on the classpath.
               Keep this off the plugin-global classPaths: validate runs earlier and
               dependency/ may not exist yet. -->
          <execution>
            <id>javacpp-compiler</id>
            <phase>process-classes</phase>
            <goals>
              <goal>build</goal>
            </goals>
            <configuration>
              <classPaths>
                <classPath>${basedir}/../openblas/target/classes/</classPath>
                <classPath>${basedir}/../cpython/target/classes/</classPath>
                <classPath>${basedir}/../numpy/target/classes/</classPath>
                <classPath>${basedir}/../cuda/target/classes/</classPath>
                <classPath>${project.build.outputDirectory}</classPath>
                <classPath>${project.build.directory}/dependency/*</classPath>
              </classPaths>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Post-parse package relocation (scripts/relocate_packages.py).
           JavaCPP Parser always emits peers into the single @Properties(target=…)
           package; this step moves torch::{data,nn,jit,optim,serialize,inductor,
           profiler,enumtype}, c10d, and uncommon c10 types into subpackages so
           every `mvn install` (including -Djavacpp.cppbuild.skip=true) yields the
           same layout. Bound to process-sources: after generate-sources parse,
           before compile. Skip with -Dpytorch.relocate.skip=true if needed. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>relocate-packages</id>
            <phase>process-sources</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <skip>${pytorch.relocate.skip}</skip>
              <executable>python3</executable>
              <workingDirectory>${project.basedir}</workingDirectory>
              <arguments>
                <argument>${project.basedir}/scripts/relocate_packages.py</argument>
                <argument>--gen-dir</argument>
                <argument>${project.basedir}/src/gen/java</argument>
                <argument>--main-dir</argument>
                <argument>${project.basedir}/src/main/java</argument>
              </arguments>
            </configuration>
          </execution>
          <!-- Fluent chain setters on *Options.java (after relocate so paths exist). -->
          <execution>
            <id>generate-nn-option-setters</id>
            <phase>process-sources</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>${java.home}/bin/java</executable>
              <workingDirectory>${project.basedir}</workingDirectory>
              <arguments>
                <argument>${project.basedir}/src/main/java/org/bytedeco/pytorch/presets/NNOptionsFluentSetterGenerator.java</argument>
                <argument>${project.basedir}/src/gen/java</argument>
              </arguments>
            </configuration>
          </execution>
          <!-- Strip multi-arg @Virtual(method="forward") on Module; inject toString. -->
          <execution>
            <id>strip-forward-virtual-annotations</id>
            <phase>process-sources</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>/bin/sh</executable>
              <workingDirectory>${project.basedir}</workingDirectory>
              <arguments>
                <argument>${project.basedir}/src/main/java/org/bytedeco/pytorch/presets/strip_module_forward.sh</argument>
                <argument>${project.basedir}/src/gen/java</argument>
              </arguments>
            </configuration>
          </execution>
          <!-- After compile, target/classes still holds empty directory skeletons from
               previous package layouts (data/dataframe, utils/transformers, kvcache, …).
               maven-jar-plugin ships every directory entry, so prune them here right
               before package. Idempotent; also cleans vacated trees under src/. -->
          <execution>
            <id>prune-stale-package-dirs</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <skip>${pytorch.relocate.skip}</skip>
              <executable>python3</executable>
              <workingDirectory>${project.basedir}</workingDirectory>
              <arguments>
                <argument>${project.basedir}/scripts/relocate_packages.py</argument>
                <argument>--prune-only</argument>
                <argument>--gen-dir</argument>
                <argument>${project.basedir}/src/gen/java</argument>
                <argument>--main-dir</argument>
                <argument>${project.basedir}/src/main/java</argument>
                <argument>--classes-dir</argument>
                <argument>${project.build.outputDirectory}</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <id>default-jar</id>
            <phase>package</phase>
            <goals>
              <goal>jar</goal>
            </goals>
            <configuration>
              <archive>
                <manifestEntries>
                  <Class-Path>javacpp.jar</Class-Path>
                  <Implementation-Title>${project.name}</Implementation-Title>
                  <Implementation-Vendor>Bytedeco</Implementation-Vendor>
                  <Implementation-Version>${project.version}</Implementation-Version>
                  <Specification-Title>${project.name}</Specification-Title>
                  <Specification-Vendor>Bytedeco</Specification-Vendor>
                  <Specification-Version>${project.version}</Specification-Version>
                  <Multi-Release>true</Multi-Release>
                  <!-- JDK launcher (java -jar THIS.jar only) applies these; format is
                       module/package, not CLI add-opens=...=ALL-UNNAMED. Dependency
                       jars are ignored — users on -cp should pass CLI flags or
                       -javaagent:pytorch.jar (Premain-Class below). -->
                  <Add-Opens>java.base/java.nio</Add-Opens>
                  <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                  <Premain-Class>org.bytedeco.pytorch.JvmModuleSupport</Premain-Class>
                  <Agent-Class>org.bytedeco.pytorch.JvmModuleSupport</Agent-Class>
                  <Can-Redefine-Classes>true</Can-Redefine-Classes>
                  <Can-Retransform-Classes>true</Can-Retransform-Classes>
                </manifestEntries>
              </archive>
              <includes>
                <include>org/bytedeco/${javacpp.packageName}/**</include>
              </includes>
              <excludes>
                <!-- Parent already drops include/; also drop presets glue headers
                     (torch_include.h etc.) — they are only needed at parse/build
                     time and must not ship inside the Java jar. -->
                <exclude>org/bytedeco/${javacpp.packageName}/include/</exclude>
                <exclude>org/bytedeco/${javacpp.packageName}/presets/**/*.h</exclude>
                <exclude>org/bytedeco/${javacpp.packageName}/presets/*.h</exclude>
                <!-- Platform dylibs live in the classifier jar (and optionally
                     target/classes for IDE). Never pack them into the main jar. -->
                <exclude>org/bytedeco/${javacpp.packageName}/macosx-*/</exclude>
                <exclude>org/bytedeco/${javacpp.packageName}/linux-*/</exclude>
                <exclude>org/bytedeco/${javacpp.packageName}/windows-*/</exclude>
                <exclude>org/bytedeco/${javacpp.packageName}/android-*/</exclude>
                <exclude>org/bytedeco/${javacpp.packageName}/ios-*/</exclude>
                <exclude>META-INF/native-image/</exclude>
              </excludes>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.moditect</groupId>
        <artifactId>moditect-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-compile-deps-for-javacpp</id>
            <phase>compile</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/dependency</outputDirectory>
              <includeScope>compile</includeScope>
              <excludeTransitive>false</excludeTransitive>
            </configuration>
          </execution>
          <!-- IDE Application runs use module output (target/classes) as classpath root.
               After mvn clean / IDEA rebuild, platform dylibs are gone and Loader fails:
               UnsatisfiedLinkError: no jnitorch. Unpack last-installed classifier jar
               so libjnitorch.dylib is visible without putting a self-dep on the run CP.
               Skip with -Dpytorch.ide.natives.skip=true. Requires prior mvn install once. -->
          <execution>
            <id>unpack-ide-platform-natives</id>
            <phase>process-classes</phase>
            <goals>
              <goal>unpack</goal>
            </goals>
            <configuration>
              <skip>${pytorch.ide.natives.skip}</skip>
              <artifactItems>
                <artifactItem>
                  <groupId>${project.groupId}</groupId>
                  <artifactId>${project.artifactId}</artifactId>
                  <version>${project.version}</version>
                  <classifier>macosx-arm64</classifier>
                  <type>jar</type>
                  <overWrite>false</overWrite>
                  <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                  <includes>org/bytedeco/pytorch/macosx-arm64/**,META-INF/native-image/macosx-arm64/**</includes>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-source-plugin</artifactId>
      </plugin>
      <plugin>
        <artifactId>maven-javadoc-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

</project>
